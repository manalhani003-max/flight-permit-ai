const _LIC_KEY = 'aris_lic_v1';

function activateKey(){
  const k = (document.getElementById('keyInput').value||'').trim().toUpperCase().replace(/[^A-Z0-9-]/g,'');
  const err = document.getElementById('keyErr');
  if(!k){ err.textContent='Enter your license key'; return; }
  const rev = k.split('').reverse().join('');
  if(_KEYS.indexOf(rev) !== -1){
    localStorage.setItem(_LIC_KEY, rev);
    launchApp();
  } else {
    err.textContent='Invalid key. Contact MANAL1871 for a valid license.';
    document.getElementById('keyInput').style.borderColor='rgba(239,68,68,.6)';
    setTimeout(function(){ err.textContent=''; document.getElementById('keyInput').style.borderColor='rgba(255,255,255,.12)'; }, 3000);
  }
}

document.getElementById('keyInput').addEventListener('keydown',function(e){
  if(e.key==='Enter') activateKey();
});

function launchApp(){
  const ov = document.getElementById('launch-overlay');
  ov.classList.add('show');
  setTimeout(function(){
    const b64 = '';
    const html = decodeURIComponent(escape(atob(b64)));
    document.open();
    document.write(html);
    document.close();
  }, 1200);
}

// Check if already activated
(function(){
  const stored = localStorage.getItem(_LIC_KEY);
  if(stored && _KEYS.indexOf(stored) !== -1){
    document.getElementById('launch-overlay').classList.add('show');
    setTimeout(function(){ launchApp(); }, 1500);
  }
})();

// ══ PHONE SUBMIT ══
function submitPhone(method) {
  const phoneEl = document.getElementById('ph-' + method);
  const phone = phoneEl ? phoneEl.value.trim() : '';
  if (!phone || phone.length < 8) {
    phoneEl.style.borderColor = 'rgba(239,68,68,.6)';
    phoneEl.placeholder = 'Please enter your phone number';
    setTimeout(function() {
      phoneEl.style.borderColor = 'rgba(255,255,255,.12)';
    }, 2000);
    return;
  }
  // Clean phone number for WhatsApp URL
  const cleanPhone = phone.replace(/[^0-9]/g, '');
  const methods = {
    cliq: 'CliQ Transfer (MANAL1871)',
    wa: 'WhatsApp Purchase',
    bk: 'Bank Transfer',
    pp: 'PayPal Payment',
    cc: 'Credit Card Payment Link'
  };
  const msg = encodeURIComponent(
    'ARIS Enterprise License Purchase\n' +
    'Method: ' + methods[method] + '\n' +
    'My WhatsApp: +' + cleanPhone + '\n' +
    'Ref: MANAL1871\n' +
    'Please send my license key to this number after confirming payment.'
  );
  // Open WhatsApp to seller (replace 00000000000 with Manal's number)
  window.open('https://wa.me/?text=' + msg, '_blank');
  // Show success message inside modal
  const mb = document.querySelector('#m-' + method + ' .mb');
  mb.innerHTML = '<div class="success-screen show">' +
    '<div class="success-icon">✅</div>' +
    '<div class="success-title">Request Sent!</div>' +
    '<div class="success-desc">Your purchase request has been sent.<br><br>' +
    'Your license key will be delivered to<br>' +
    '<strong style="color:#60a5fa">+' + cleanPhone + '</strong><br><br>' +
    'within a few hours after payment confirmation.<br><br>' +
    '<span style="font-size:11px;color:#64748b">Questions? WhatsApp: MANAL1871</span></div>' +
    '<button class="pbtn pb-wa" style="width:100%;margin-top:20px" onclick="closeM(\'' + method + '\')">' +
    'Done</button></div>';
}

</script>
