<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ARIS — Aviation Risk Intelligence System</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Montserrat:wght@700;800;900&display=swap');
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --navy:#040d1f;--blue:#2563eb;--cyan:#06b6d4;
  --gold:#f59e0b;--green:#10b981;--red:#ef4444;
  --txt:#e8f0fe;--muted:#7090b0;--border:rgba(255,255,255,.08);
}
body{background:var(--navy);color:var(--txt);font-family:Inter,sans-serif;line-height:1.6;scroll-behavior:smooth}
.pg{max-width:960px;margin:0 auto;padding:0 32px}

/* HERO */
.hero{background:linear-gradient(135deg,#040d1f 0%,#071e3d 55%,#0a1628 100%);
  padding:80px 0 60px;position:relative;overflow:hidden;border-bottom:1px solid var(--border)}
.hero::before{content:'';position:absolute;top:-40%;left:-10%;width:600px;height:600px;
  background:radial-gradient(circle,rgba(37,99,235,.18) 0%,transparent 70%)}
.hero-badge{display:inline-flex;align-items:center;gap:8px;
  background:rgba(37,99,235,.15);border:1px solid rgba(37,99,235,.4);
  border-radius:100px;padding:6px 16px;font-size:11px;font-weight:600;
  color:#60a5fa;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:24px}
.hero-badge i{width:6px;height:6px;background:#60a5fa;border-radius:50%;
  animation:pulse 2s infinite;display:inline-block}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
.hero h1{font-family:Montserrat,sans-serif;font-size:56px;font-weight:900;line-height:1.05;
  margin-bottom:6px;
  background:linear-gradient(135deg,#fff 0%,#93c5fd 50%,#60a5fa 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hero-sub{font-size:20px;font-weight:300;color:#93c5fd;margin-bottom:18px;letter-spacing:.5px}
.hero-desc{font-size:15px;color:var(--muted);max-width:560px;line-height:1.8;margin-bottom:32px}
.pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:36px}
.pill{border-radius:100px;padding:5px 14px;font-size:12px;font-weight:500}
.pill-b{background:rgba(37,99,235,.15);border:1px solid rgba(37,99,235,.4);color:#60a5fa}
.pill-g{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);color:#34d399}
.pill-o{background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.3);color:#fbbf24}
.pill-w{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);color:#94a3b8}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;
  background:var(--border);border:1px solid var(--border);border-radius:14px;overflow:hidden}
.stat{background:rgba(255,255,255,.03);padding:20px;text-align:center}
.snum{font-size:30px;font-weight:900;font-family:Montserrat,sans-serif;color:#fff}
.snum sup{font-size:16px;color:var(--blue)}
.slbl{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:4px}

/* SECTIONS */
section{padding:60px 0}
.stag{font-size:11px;color:var(--cyan);letter-spacing:2px;text-transform:uppercase;font-weight:700;margin-bottom:10px}
h2{font-family:Montserrat,sans-serif;font-size:32px;font-weight:800;margin-bottom:14px;line-height:1.2}
.sdesc{font-size:15px;color:var(--muted);max-width:600px;line-height:1.8;margin-bottom:40px}
.divider{height:1px;background:var(--border)}

/* SCREENSHOTS */
.ss-wrap{border-radius:16px;overflow:hidden;border:1px solid rgba(255,255,255,.12);
  box-shadow:0 24px 80px rgba(0,0,0,.6);margin-bottom:16px}
.ss-wrap img{width:100%;display:block}
.ss-bar{background:linear-gradient(90deg,rgba(7,20,40,.95),rgba(10,30,60,.95));
  padding:10px 16px;display:flex;align-items:center;gap:8px;border-top:1px solid var(--border)}
.dot{width:10px;height:10px;border-radius:50%}
.dr{background:#ef4444}.dy{background:#f59e0b}.dg{background:#10b981}
.ss-cap{font-size:11px;color:var(--muted);text-align:center;margin-bottom:36px;letter-spacing:.5px}

/* FEATURES */
.fg{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:40px}
.fc{background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:14px;padding:22px}
.fi{font-size:26px;margin-bottom:12px}
.ft{font-size:14px;font-weight:700;color:#e2e8f0;margin-bottom:6px}
.fd{font-size:12px;color:var(--muted);line-height:1.7}
.fb{display:inline-block;font-size:10px;font-weight:600;padding:2px 8px;border-radius:4px;margin-top:8px}
.fb-b{background:rgba(37,99,235,.2);color:#60a5fa}
.fb-g{background:rgba(16,185,129,.15);color:#34d399}
.fb-o{background:rgba(245,158,11,.15);color:#fbbf24}

/* LAYERS */
.layers{display:flex;flex-direction:column;gap:8px;margin-bottom:40px}
.lr{display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.02);
  border:1px solid var(--border);border-radius:12px;padding:14px 18px}
.ln{font-size:10px;font-weight:800;color:var(--blue);font-family:Montserrat,sans-serif;min-width:22px}
.lic{font-size:18px;min-width:26px}
.lt{font-size:13px;font-weight:700;color:#e2e8f0;min-width:170px}
.ld{font-size:12px;color:var(--muted);flex:1}
.lw{font-size:10px;color:rgba(96,165,250,.7);font-family:monospace;white-space:nowrap}

/* VERDICT */
.vg{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:40px}
.vc{border-radius:12px;padding:18px;text-align:center}
.va{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3)}
.vb{background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.3)}
.vr{background:rgba(37,99,235,.08);border:1px solid rgba(37,99,235,.3)}
.vx{background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.3)}
.vi{font-size:22px;margin-bottom:6px}
.vl{font-size:10px;font-weight:800;letter-spacing:1px;text-transform:uppercase}
.vr2{font-size:10px;color:var(--muted);margin-top:3px}
.va .vl{color:#34d399}.vb .vl{color:#fbbf24}.vr .vl{color:#60a5fa}.vx .vl{color:#f87171}

/* DB */
.dg2{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:40px}
.dc{background:rgba(255,255,255,.02);border:1px solid var(--border);
  border-radius:12px;padding:18px;display:flex;align-items:center;gap:14px}
.dn{font-size:34px;font-weight:900;font-family:Montserrat,sans-serif}
.dn-b{color:#60a5fa}.dn-g{color:#34d399}.dn-o{color:#fbbf24}.dn-r{color:#f87171}
.dl{font-size:13px;font-weight:700;color:#e2e8f0}
.ds{font-size:11px;color:var(--muted)}

/* REFERENCES */
.rg{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:40px}
.ri{background:rgba(255,255,255,.02);border:1px solid var(--border);
  border-radius:10px;padding:12px;font-size:11px;color:#94a3b8;font-family:monospace}
.ri strong{display:block;color:#e2e8f0;font-family:Inter,sans-serif;margin-bottom:2px}

/* ══ PRICING ══ */
.pricing{background:linear-gradient(135deg,rgba(7,20,40,.98),rgba(10,30,60,.98));
  border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:80px 0}
.pw{max-width:680px;margin:0 auto;padding:0 32px;text-align:center}
.ptag{font-size:11px;color:var(--gold);letter-spacing:3px;text-transform:uppercase;font-weight:700;margin-bottom:14px}
.ph2{font-family:Montserrat,sans-serif;font-size:36px;font-weight:900;color:#fff;margin-bottom:8px}
.psub{font-size:15px;color:var(--muted);margin-bottom:36px}
.pcard{background:linear-gradient(135deg,rgba(37,99,235,.12),rgba(6,182,212,.06));
  border:2px solid rgba(37,99,235,.5);border-radius:24px;padding:36px;
  margin-bottom:28px;position:relative;overflow:hidden}
.pcard::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,#2563eb,#06b6d4,#10b981)}
.pbadge{position:absolute;top:14px;right:14px;
  background:linear-gradient(135deg,#f59e0b,#d97706);
  color:#fff;font-size:10px;font-weight:800;padding:4px 12px;
  border-radius:100px;letter-spacing:1px}
.pname{font-size:12px;font-weight:600;color:var(--cyan);letter-spacing:2px;
  text-transform:uppercase;margin-bottom:14px}
.pamt{font-family:Montserrat,sans-serif;font-size:68px;font-weight:900;
  line-height:1;color:#fff;margin-bottom:4px}
.pamt sup{font-size:28px;vertical-align:super;color:#93c5fd}
.pcur{font-size:13px;color:var(--muted);margin-bottom:22px}
.pinc{text-align:left;margin-bottom:24px}
.pitem{display:flex;align-items:flex-start;gap:8px;margin-bottom:8px;font-size:13px;color:#cbd5e1}
.pitem::before{content:'✓';color:#10b981;font-weight:800;flex-shrink:0}
.paytit{font-size:12px;font-weight:700;color:#94a3b8;text-transform:uppercase;
  letter-spacing:1px;margin-bottom:14px}
.paygrid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:28px}
.pbtn{display:flex;align-items:center;justify-content:center;gap:10px;
  padding:15px 18px;border-radius:12px;font-size:14px;font-weight:700;
  cursor:pointer;border:none;text-decoration:none;font-family:Inter,sans-serif;transition:all .2s}
.pb-cliq{background:linear-gradient(135deg,#0ea5e9,#0284c7);color:#fff;}
.pb-cliq:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(14,165,233,.4)}
.pb-wa{background:linear-gradient(135deg,#25d366,#128c7e);color:#fff;
  box-shadow:0 4px 16px rgba(37,211,102,.3)}
.pb-wa:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(37,211,102,.4)}
.pb-bk{background:linear-gradient(135deg,#1e40af,#1d4ed8);color:#fff;
  box-shadow:0 4px 16px rgba(37,99,235,.3)}
.pb-bk:hover{transform:translateY(-2px)}
.pb-pp{background:linear-gradient(135deg,#0070ba,#003087);color:#fff;
  box-shadow:0 4px 16px rgba(0,112,186,.3)}
.pb-pp:hover{transform:translateY(-2px)}
.pb-cc{background:linear-gradient(135deg,#7c3aed,#6d28d9);color:#fff;
  box-shadow:0 4px 16px rgba(124,58,237,.3)}
.pb-cc:hover{transform:translateY(-2px)}
.pico{font-size:18px}

/* ALREADY HAVE KEY */
.have-key{background:rgba(16,185,129,.06);border:1px solid rgba(16,185,129,.25);
  border-radius:14px;padding:22px;margin-top:20px}
.hk-title{font-size:13px;font-weight:700;color:#34d399;margin-bottom:8px}
.hk-row{display:flex;gap:8px}
.hk-input{flex:1;padding:12px 14px;border-radius:10px;border:1px solid rgba(255,255,255,.12);
  background:rgba(255,255,255,.06);color:#fff;font-size:14px;
  letter-spacing:2px;font-family:monospace;outline:none;font-size:13px}
.hk-btn{padding:12px 20px;border-radius:10px;border:none;cursor:pointer;
  background:linear-gradient(135deg,#10b981,#059669);color:#fff;
  font-size:13px;font-weight:700;font-family:Inter,sans-serif;white-space:nowrap}
.hk-err{font-size:11px;color:#f87171;margin-top:6px;min-height:18px}

/* HOW */
.hg{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;text-align:left;margin-bottom:8px}
.hc{background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:12px;padding:18px}
.hn{font-family:Montserrat,sans-serif;font-size:30px;font-weight:900;color:var(--blue);line-height:1;margin-bottom:6px}
.ht{font-size:13px;font-weight:700;color:#e2e8f0;margin-bottom:4px}
.hd{font-size:11px;color:var(--muted);line-height:1.6}

/* MODALS */
.mo{display:none;position:fixed;inset:0;background:rgba(0,0,0,.85);
  z-index:1000;align-items:center;justify-content:center;padding:20px}
.mo.open{display:flex}
.mb{background:#0f1e38;border:1px solid rgba(37,99,235,.4);border-radius:20px;
  padding:28px;max-width:420px;width:100%;position:relative}
.mtit{font-family:Montserrat,sans-serif;font-size:18px;font-weight:800;margin-bottom:6px;color:#fff}
.msub{font-size:13px;color:var(--muted);margin-bottom:18px;line-height:1.6}
.mcls{position:absolute;top:14px;right:14px;background:rgba(255,255,255,.08);
  border:none;color:#94a3b8;width:30px;height:30px;border-radius:50%;
  cursor:pointer;font-size:15px}
.crow{display:flex;align-items:center;gap:8px;
  background:rgba(255,255,255,.05);border:1px solid var(--border);
  border-radius:8px;padding:10px 14px;margin-bottom:10px}
.crow span{flex:1;font-size:12px;color:#e2e8f0;font-family:monospace}
.cbtn{background:rgba(37,99,235,.3);border:1px solid rgba(37,99,235,.5);
  color:#60a5fa;padding:4px 10px;border-radius:5px;cursor:pointer;font-size:11px;
  font-weight:600;white-space:nowrap}
.mnote{font-size:11px;color:var(--muted);line-height:1.6;
  background:rgba(245,158,11,.06);border:1px solid rgba(245,158,11,.2);
  border-radius:8px;padding:10px;margin-top:14px}

/* FOOTER */
footer{border-top:1px solid var(--border);padding:28px 0;font-size:11px;color:var(--muted)}
.fi2{display:flex;justify-content:space-between;align-items:center}

/* ══ LAUNCH SCREEN (replaces everything after activation) ══ */
#launch-overlay{
  display:none;position:fixed;inset:0;z-index:99998;
  background:linear-gradient(135deg,#040d1f,#071e3d);
  align-items:center;justify-content:center;flex-direction:column;
  font-family:Inter,sans-serif;
}
#launch-overlay.show{display:flex}
.launch-anim{font-size:56px;animation:spin 1s linear infinite;margin-bottom:16px}
@keyframes spin{to{transform:rotate(360deg)}}
.launch-txt{font-size:15px;color:#60a5fa;font-weight:600}

@media(max-width:768px){
  .hero h1{font-size:36px}.fg{grid-template-columns:1fr}
  .stats{grid-template-columns:repeat(2,1fr)}.paygrid{grid-template-columns:1fr}
  .dg2{grid-template-columns:1fr}.vg{grid-template-columns:repeat(2,1fr)}
  .rg{grid-template-columns:1fr}.hg{grid-template-columns:1fr}
  .fi2{flex-direction:column;gap:6px;text-align:center}
}

/* PHONE INPUT */
.ph-why{display:flex;gap:12px;align-items:flex-start;
  background:rgba(37,99,235,.07);border:1px solid rgba(37,99,235,.2);
  border-radius:10px;padding:12px;margin-bottom:14px}
.ph-why-icon{font-size:22px;flex-shrink:0;margin-top:2px}
.ph-why-txt{font-size:12px;color:#94a3b8;line-height:1.6}
.ph-why-txt strong{color:#93c5fd;display:block;margin-bottom:2px}
.ph-label{display:block;font-size:11px;color:#94a3b8;font-weight:600;
  text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px}
.ph-row{display:flex;gap:8px;margin-bottom:4px}
.ph-input{flex:1;padding:12px 14px;border-radius:10px;
  border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.06);
  color:#fff;font-size:15px;font-family:monospace;outline:none;
  letter-spacing:1px;transition:border-color .2s}
.ph-input:focus{border-color:rgba(37,99,235,.6)}

/* SUCCESS SCREEN */
.success-screen{display:none;text-align:center;padding:20px 0}
.success-screen.show{display:block}
.success-icon{font-size:52px;margin-bottom:12px}
.success-title{font-size:18px;font-weight:800;color:#34d399;margin-bottom:8px}
.success-desc{font-size:13px;color:#94a3b8;line-height:1.6}
</style>
</head>
<body>

<!-- LAUNCH ANIMATION -->
<div id="launch-overlay">
  <div class="launch-anim">✈</div>
  <div class="launch-txt">Launching ARIS Enterprise…</div>
</div>

<!-- ══ HERO ══ -->
<div class="hero">
<div class="pg">
  <div class="hero-badge"><i></i>Enterprise Aviation Intelligence</div>
  <h1>ARIS</h1>
  <div class="hero-sub">Aviation Risk Intelligence System</div>
  <p class="hero-desc">The professional-grade flight risk assessment platform for aviation dispatch, permit offices, and operations teams. Analyze any flight in seconds — fully documented, fully referenced.</p>
  <div class="pills">
    <span class="pill pill-b">✦ ICAO SMS Compliant</span>
    <span class="pill pill-g">✦ Works Offline</span>
    <span class="pill pill-o">✦ Bilingual AR / EN</span>
    <span class="pill pill-w">✦ No Server Required</span>
    <span class="pill pill-w">✦ Instant PDF Export</span>
  </div>
  <div class="stats">
    <div class="stat"><div class="snum">440<sup>+</sup></div><div class="slbl">Airports</div></div>
    <div class="stat"><div class="snum">53</div><div class="slbl">Risk Countries</div></div>
    <div class="stat"><div class="snum">107</div><div class="slbl">Reg. Prefixes</div></div>
    <div class="stat"><div class="snum">7</div><div class="slbl">Risk Layers</div></div>
  </div>
</div>
</div>

<!-- ══ SCREENSHOTS ══ -->
<section><div class="pg">
  <div class="stag">The Platform</div>
  <h2>Enterprise-Grade Interface</h2>
  <p class="sdesc">A sophisticated single-file application — zero installation, zero server, runs in any modern browser. Banking-style dark UI designed for dispatch professionals.</p>
  <div class="ss-wrap">
    <div class="ss-bar"><div class="dot dr"></div><div class="dot dy"></div><div class="dot dg"></div>
      <span style="font-size:11px;color:#475569;margin-left:8px">ARIS v10.23 Enterprise — Main Dashboard</span></div>
    <img src="data:image/png;base64," alt="ARIS Dashboard">
  </div>
  <p class="ss-cap">Main Dashboard — Flight Input · AI Analysis · Live Map · Risk History</p>
  <div class="ss-wrap">
    <div class="ss-bar"><div class="dot dr"></div><div class="dot dy"></div><div class="dot dg"></div>
      <span style="font-size:11px;color:#475569;margin-left:8px">Risk Assessment Results — 7-Layer Scoring</span></div>
    <img src="data:image/png;base64," alt="ARIS Results">
  </div>
  <p class="ss-cap">Instant Risk Verdict · Score Breakdown · Route Map · Risk Flags</p>
</div></section>
<div class="divider"></div>

<!-- ══ ENGINE ══ -->
<section><div class="pg">
  <div class="stag">Risk Engine</div>
  <h2>7-Layer Weighted Assessment</h2>
  <p class="sdesc">Multi-layer weighted scoring aligned with ICAO SMS Doc 9859. Each layer produces a 0–100 score combined into a final risk index.</p>
  <div class="layers">
    <div class="lr"><div class="ln">01</div><div class="lic">🌍</div><div class="lt">Country / Sanctions</div><div class="ld">OFAC SDN · EU Air Safety List · UN Security Council · conflict risk</div><div class="lw">28%</div></div>
    <div class="lr"><div class="ln">02</div><div class="lic">🛫</div><div class="lt">Airport Risk</div><div class="ld">Military / joint-use · NOTAMs · ATC capability · airport category</div><div class="lw">21%</div></div>
    <div class="lr"><div class="ln">03</div><div class="lic">📦</div><div class="lt">Cargo / Dangerous Goods</div><div class="ld">IATA DGR 11th Ed. · 150+ cargo types · UN number detection</div><div class="lw">17%</div></div>
    <div class="lr"><div class="ln">04</div><div class="lic">🏢</div><div class="lt">Operator / Aircraft</div><div class="ld">Watch-list screening · AOC validity · VIP / humanitarian / military</div><div class="lw">15%</div></div>
    <div class="lr"><div class="ln">05</div><div class="lic">🗺️</div><div class="lt">Route / Airspace</div><div class="ld">Conflict zone overflight · FIR crossing · 17 active restricted zones</div><div class="lw">10%</div></div>
    <div class="lr"><div class="ln">06</div><div class="lic">🏥</div><div class="lt">Health / Biosecurity</div><div class="ld">WHO IHR 2005 · MOH health alerts · disease outbreak monitoring</div><div class="lw">5%</div></div>
    <div class="lr"><div class="ln">07</div><div class="lic">📋</div><div class="lt">Documentation</div><div class="ld">Permit completeness · NOTAM compliance · special clearances</div><div class="lw">4%</div></div>
  </div>
  <div class="vg">
    <div class="vc va"><div class="vi">✅</div><div class="vl">Approved</div><div class="vr2">0 – 24</div></div>
    <div class="vc vb"><div class="vi">⚡</div><div class="vl">Conditional</div><div class="vr2">25 – 54</div></div>
    <div class="vc vr"><div class="vi">⚠️</div><div class="vl">Review</div><div class="vr2">55 – 79</div></div>
    <div class="vc vx"><div class="vi">⛔</div><div class="vl">Rejected</div><div class="vr2">80 – 100</div></div>
  </div>
</div></section>
<div class="divider"></div>

<!-- ══ FEATURES ══ -->
<section><div class="pg">
  <div class="stag">Key Features</div>
  <h2>Everything in One File</h2>
  <p class="sdesc">No installation. No subscription. No cloud dependency. Single HTML file — every database, algorithm, and UI component included.</p>
  <div class="fg">
    <div class="fc"><div class="fi">🤖</div><div class="ft">Claude AI Text Analysis</div><div class="fd">Paste any permit, NOTAM, ATS message or email in Arabic or English. Extracts all flight data automatically.</div><span class="fb fb-b">Anthropic Claude</span></div>
    <div class="fc"><div class="fi">⛽</div><div class="ft">ICAO Fuel Planning</div><div class="fd">5-component fuel calculation: Trip + Contingency + Alternate + Holding + Final Reserve (ICAO Annex 6).</div><span class="fb fb-g">ICAO Annex 6</span></div>
    <div class="fc"><div class="fi">🗺️</div><div class="ft">Route Optimization</div><div class="fd">Compare 3 routes with distance, ETA, fuel, risk score, and airspace stability for each option.</div><span class="fb fb-b">Multi-FIR</span></div>
