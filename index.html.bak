  var origActivate=window.activateKey;
  window.activateKey=function(){
    var raw=(document.getElementById('keyInput').value||'').trim().toUpperCase().replace(/[^A-Z0-9-]/g,'');
    if(!raw){document.getElementById('keyErr').textContent='Enter your license key';return;}
    var rev=raw.split('').reverse().join('');
    if(IKEYS.indexOf(rev)!==-1){
      localStorage.setItem('aris_lic_v1',rev);
      launchApp();
    } else {
      var e=document.getElementById('keyErr');
      e.textContent='Invalid key. Contact MANAL1871 for a valid license.';
      document.getElementById('keyInput').style.borderColor='rgba(239,68,68,.6)';
      setTimeout(function(){e.textContent='';document.getElementById('keyInput').style.borderColor='rgba(255,255,255,.12)';},3000);
    }
  };
})();
